# Ignore everything, then allow only the files that belong to the repo.
/*
!/.gitignore
!/Dockerfile

!/nginx/
/nginx/*
!/nginx/default.conf

!/scripts/
/scripts/*
!/scripts/90-headscale-exporter.sh
!/scripts/fetch.sh

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/docker.yml
